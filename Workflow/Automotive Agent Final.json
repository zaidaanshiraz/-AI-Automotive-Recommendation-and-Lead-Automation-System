      "parameters": {
        "jsCode": "// 1. Get the raw AI recommendation text\nlet rawRecommendation = $('Final_recommendation').item.json.final_recommendation;\n\n// 2. Clean the formatting:\n// Convert Markdown bold (**text**) to HTML bold (<strong>text</strong>)\n// Convert newlines (\\n) to HTML line breaks (<br>)\nlet cleanedRecommendation = rawRecommendation\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/\\n/g, '<br>');\n\n// 3. Build the HTML template\nconst html = `\n<html>\n<body style=\"font-family: Arial, sans-serif; padding: 40px; color: #333; line-height: 1.6;\">\n  <div style=\"max-width: 600px; margin: 0 auto; border: 1px solid #eaeaea; padding: 30px; border-radius: 10px;\">\n    <h1 style=\"color: #e94560; margin-top: 0;\">Your Personalized Car Brochure</h1>\n    <h2 style=\"color: #555;\">Prepared for: ${$('Edit Fields').item.json.name}</h2>\n    \n    <div style=\"background: #f9f9f9; padding: 15px; border-radius: 8px; margin: 20px 0;\">\n      <p style=\"margin: 0;\"><strong>Requirement:</strong> ${$('Edit Fields').item.json.Type} for ${$('Edit Fields').item.json.Purpose}</p>\n      <p style=\"margin: 5px 0 0 0;\"><strong>Budget:</strong> ${$('Edit Fields').item.json.Budget}</p>\n    </div>\n    \n    <hr style=\"border: none; border-top: 1px solid #eee; margin: 20px 0;\">\n    \n    <h3 style=\"color: #0f3460;\">Our Top Recommendation & Comparison:</h3>\n    <p style=\"font-size: 15px;\">${cleanedRecommendation}</p>\n  </div>\n</body>\n</html>\n`;\n\n// 4. Convert to Binary for the email attachment\nconst buffer = Buffer.from(html);\n\nreturn {\n  json: $input.item.json,\n  binary: {\n    attachment: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'Personalized_Brochure.html'\n    }\n  }\n};"
      },

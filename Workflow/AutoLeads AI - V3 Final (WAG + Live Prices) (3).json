    {
      "parameters": {
        "jsCode": "\n// Safely extract search results and news into clean text context\nconst items = $input.all();\n\nlet searchData = \"\";\nlet newsData = \"\";\n\nfor (const item of items) {\n  // Organic results (from /search endpoint)\n  if (item.json.organic && Array.isArray(item.json.organic)) {\n    searchData = item.json.organic.slice(0, 4).map((r, i) => \n      `[Result ${i+1}] ${r.title || ''}: ${r.snippet || ''}`\n    ).join(\"\\n\");\n  }\n  // News results (from /news endpoint)\n  if (item.json.news && Array.isArray(item.json.news)) {\n    newsData = item.json.news.slice(0, 4).map((n, i) =>\n      `[News ${i+1}] ${n.title || ''}: ${n.snippet || ''} (${n.date || ''})`\n    ).join(\"\\n\");\n  }\n}\n\n// Pass through original lead data from Edit Fields\nconst lead = $('Edit Fields').item.json;\n\nreturn [{\n  json: {\n    name: lead.name,\n    Budget: lead.budget,\n    Type: lead.type,\n    Purpose: lead.purpose,\n    email: lead.email,\n    phone: lead.phone,\n    wag_search_context: searchData || \"No organic results found.\",\n    wag_news_context: newsData || \"No news results found.\"\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

      "parameters": {
        "jsCode": "\nconst name = $('Edit Fields').item.json.name;\nconst budgetRaw = $('Edit Fields').item.json.budget;\nconst budgetMap = {500000:'Under Rs.5 Lakhs',700000:'Rs.5–7 Lakhs',1000000:'Rs.7–10 Lakhs',1500000:'Rs.10–15 Lakhs',2000000:'Rs.15–20 Lakhs',3000000:'Rs.20–30 Lakhs',5000000:'Rs.30–50 Lakhs',7500000:'Rs.50–75 Lakhs',10000000:'Above Rs.1 Crore'};\nconst budget = budgetMap[budgetRaw] || 'Rs.' + (budgetRaw/100000) + ' Lakhs';\nconst carType = $('Edit Fields').item.json.type;\nconst purpose = $('Edit Fields').item.json.purpose;\nconst recommendation = $('Final_recommendation').item.json.final_recommendation\n  .replace(/^### (.+)$/gm, '<h3 style=\"color:#e94560;margin:14px 0 4px;font-size:14px;\">$1</h3>')\n  .replace(/^## (.+)$/gm, '<h2 style=\"color:#e94560;margin:16px 0 6px;font-size:16px;\">$1</h2>')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/^\\d+\\. (.+)$/gm, '<div style=\"margin:6px 0;padding-left:10px;\"><strong>●</strong> $1</div>')\n  .replace(/^[\\*\\+\\-] (.+)$/gm, '<div style=\"margin:3px 0;padding-left:18px;color:#555;\">→ $1</div>')\n  .replace(/\\n/g, '<br>');\nconst competitorInsight = $('competitor_insight').item.json.competitor_insight\n  .replace(/^### (.+)$/gm, '<h3 style=\"color:#0f3460;margin:12px 0 4px;font-size:14px;\">$1</h3>')\n  .replace(/\\*\\*(.*?)\\*\\*/g, '<strong>$1</strong>')\n  .replace(/^[\\*\\+\\-] (.+)$/gm, '<div style=\"margin:3px 0;padding-left:18px;color:#555;\">→ $1</div>')\n  .replace(/\\n/g, '<br>');\nconst score = $('lead_score_analysis').item.json.lead_score_analysis;\n\nconst html = `<!DOCTYPE html>\n<html>\n<head>\n<style>\n  body { font-family: Arial, sans-serif; background: #f4f6fa; margin: 0; padding: 24px; color: #333; }\n  .page { max-width: 680px; margin: 0 auto; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.10); }\n  .header { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); padding: 36px; text-align: center; }\n  .header h1 { color: #e94560; font-size: 26px; margin: 0 0 8px; letter-spacing: 1px; }\n  .header p { color: #a8b2d8; margin: 0; font-size: 14px; }\n  .section { padding: 24px 32px; border-bottom: 1px solid #eee; }\n  .section:last-child { border-bottom: none; }\n  .section h2 { color: #0f3460; font-size: 15px; margin: 0 0 10px; text-transform: uppercase; letter-spacing: 0.5px; }\n  .section p { color: #444; line-height: 1.75; font-size: 14px; margin: 0; }\n  .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }\n  .tag { background: #f0f4ff; color: #0f3460; border-radius: 20px; padding: 4px 14px; font-size: 12px; font-weight: 600; }\n  .score-box { background: #e94560; color: #fff; padding: 18px 32px; text-align: center; font-weight: bold; font-size: 15px; }\n  .footer { padding: 16px; text-align: center; color: #aaa; font-size: 11px; }\n</style>\n</head>\n<body>\n<div class=\"page\">\n  <div class=\"header\">\n    <h1>&#x1F697; AutoLeads AI — Your Car Report</h1>\n    <p>Personalised for ${name} &nbsp;|&nbsp; Powered by Live Web Data</p>\n  </div>\n  <div class=\"section\">\n    <h2>Your Requirements</h2>\n    <div class=\"tags\">\n      <span class=\"tag\">Budget: ${budget} Lakh</span>\n      <span class=\"tag\">Type: ${carType}</span>\n      <span class=\"tag\">Purpose: ${purpose}</span>\n    </div>\n  </div>\n  <div class=\"section\">\n    <h2>&#x1F3C6; AI Recommendation (Live Market Data)</h2>\n    <p>${recommendation}</p>\n  </div>\n  <div class=\"section\">\n    <h2>&#x26A1; Why It Beats the Competition</h2>\n    <p>${competitorInsight}</p>\n  </div>\n  <div class=\"score-box\">Lead Status: ${score}</div>\n  <div class=\"footer\">Generated by AutoLeads AI &nbsp;|&nbsp; n8n + Groq + Serper Web Search</div>\n</div>\n</body>\n</html>`;\n\nconst buffer = Buffer.from(html);\nreturn {\n  json: $input.item.json,\n  binary: {\n    attachment: {\n      data: buffer.toString('base64'),\n      mimeType: 'text/html',\n      fileName: 'AutoLeads_Car_Report.html'\n    }\n  }\n};\n"
      },
